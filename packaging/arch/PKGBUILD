# Maintainer: Flightdeck authors
#
# Builds the package from this working copy (no download): run `makepkg -si` inside
# packaging/arch. Build artefacts (src/, pkg/, *.pkg.tar.*) are git-ignored.
# The version comes from the workspace Cargo.toml: bump it there (semver) for each release.

pkgname=flightdeck
pkgver=0.4.0
pkgrel=1
pkgdesc="Fast, keyboard-first cockpit for Camunda 7 process engines, with a built-in MCP server"
arch=('x86_64' 'aarch64')
url="https://github.com/flightdeck/flightdeck"
license=('MIT')
# Everything graphical is loaded at run time (dlopen), so ldd shows only libc: list it by hand.
depends=(
  'gcc-libs' 'glibc'
  'vulkan-icd-loader'            # wgpu renders through Vulkan
  'wayland' 'libxkbcommon'       # native Wayland window + keymaps
  'libx11' 'libxcursor' 'libxi' 'libxcb' 'libxkbcommon-x11' 'libglvnd'  # X11 / Xwayland fallback
  'hicolor-icon-theme'
)
optdepends=(
  'vulkan-radeon: GPU rendering on AMD'
  'vulkan-intel: GPU rendering on Intel'
  'nvidia-utils: GPU rendering on NVIDIA'
  'vulkan-swrast: software rendering when no GPU driver is available'
  'xdg-desktop-portal: follow the desktop light/dark theme'
  'glib2: theme detection via gdbus (or systemd for busctl)'
  'xdg-utils: open links in the browser'
)
makedepends=('cargo' 'librsvg')
# !debug and the environment reset in build() keep the compiler invocation identical to a plain
# `cargo build --release`, so the shared target/ is reused instead of rebuilt.
options=('!lto' '!debug')
source=()
sha256sums=()

_repo="$startdir/../.."

pkgver() {
  # The version is owned by Cargo.toml (semantic versioning, bumped per release); no git suffix.
  sed -n 's/^version = "\(.*\)"/\1/p' "$_repo/Cargo.toml" | head -n1
}

# Packaging only: tests and lints are the developer's and CI's job, not makepkg's. The build
# reuses the repository's target/ (or $CARGO_TARGET_DIR), so an already built tree is not
# compiled again. FLIGHTDECK_PREBUILT=/path/to/flightdeck packages a ready binary without cargo
# (CI builds once on an old glibc and reuses that binary here).
_target_dir() { printf '%s' "${CARGO_TARGET_DIR:-$_repo/target}"; }

prepare() {
  [ -n "${FLIGHTDECK_PREBUILT:-}" ] && return 0
  cd "$_repo"
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$_repo"
  if [ -z "${FLIGHTDECK_PREBUILT:-}" ]; then
    export CARGO_TARGET_DIR="$(_target_dir)"
    # makepkg's flags and its per-run SOURCE_DATE_EPOCH (tracked by ring's build script) would
    # make cargo rebuild the whole tree; build exactly as `cargo build --release` does.
    env -u RUSTFLAGS -u CFLAGS -u CXXFLAGS -u CPPFLAGS -u LDFLAGS -u LTOFLAGS -u SOURCE_DATE_EPOCH \
      cargo build --release --locked --frozen -p cockpit
  fi
  # hicolor rasters from the SVG master
  local s
  for s in 16 22 24 32 48 64 128 256 512; do
    rsvg-convert -w "$s" -h "$s" assets/icon.svg -o "$srcdir/flightdeck-$s.png"
  done
}

package() {
  cd "$_repo"
  install -Dm755 "${FLIGHTDECK_PREBUILT:-$(_target_dir)/release/flightdeck}" "$pkgdir/usr/bin/flightdeck"
  install -Dm644 packaging/flightdeck.desktop "$pkgdir/usr/share/applications/flightdeck.desktop"
  install -Dm644 assets/icon.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/flightdeck.svg"
  local s
  for s in 16 22 24 32 48 64 128 256 512; do
    install -Dm644 "$srcdir/flightdeck-$s.png" "$pkgdir/usr/share/icons/hicolor/${s}x${s}/apps/flightdeck.png"
  done
  # language packs: the app searches /usr/share/flightdeck/locales (XDG_DATA_DIRS)
  install -Dm644 locales/*.ftl -t "$pkgdir/usr/share/flightdeck/locales"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md DESIGN.md docs/USAGE.md -t "$pkgdir/usr/share/doc/$pkgname"
  install -Dm644 .claude/skills/flightdeck/SKILL.md "$pkgdir/usr/share/doc/$pkgname/mcp-skill.md"
}
