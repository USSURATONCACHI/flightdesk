<?xml version="1.0" encoding="utf-8"?>
<!-- Directory installer for the portable archive: the payload stays beside the .msi (uncompressed,
     relative paths), built on Linux with wixl. Version is injected with -D Version=x.y.z. -->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*" Name="Flightdeck" Language="1033" Version="$(var.Version)" Manufacturer="Flightdeck authors"
           UpgradeCode="6f3d1c2a-5b7e-4c9d-9a1e-2f8b4d6c7e01">
    <Package InstallerVersion="200" Compressed="no" InstallScope="perMachine" Description="Flightdeck - a fast, keyboard-first cockpit for Camunda 7" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of Flightdeck is already installed." />
    <Media Id="1" Cabinet="" DiskPrompt="Flightdeck" />
    <Icon Id="FlightdeckIcon" SourceFile="$(var.Stage)/flightdeck.ico" />
    <Property Id="ARPPRODUCTICON" Value="FlightdeckIcon" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLDIR" Name="Flightdeck">
          <Component Id="MainExe" Guid="4b1a9c2e-0d3f-4a5b-8c6d-7e8f9a0b1c21" Win64="yes">
            <File Id="FlightdeckExe" Source="$(var.Stage)/flightdeck.exe" KeyPath="yes" />
          </Component>
          <Component Id="License" Guid="4b1a9c2e-0d3f-4a5b-8c6d-7e8f9a0b1c22" Win64="yes">
            <File Id="LicenseTxt" Source="$(var.Stage)/LICENSE.txt" KeyPath="yes" />
          </Component>
          <Component Id="RunInPlace" Guid="4b1a9c2e-0d3f-4a5b-8c6d-7e8f9a0b1c23" Win64="yes">
            <File Id="RunInPlaceCmd" Source="$(var.Stage)/run-in-place.cmd" KeyPath="yes" />
          </Component>
          <Directory Id="LocalesDir" Name="locales">
            <Component Id="LocaleEn" Guid="4b1a9c2e-0d3f-4a5b-8c6d-7e8f9a0b1c31" Win64="yes">
              <File Id="LocaleEnUs" Source="$(var.Stage)/locales/en-US.ftl" KeyPath="yes" />
            </Component>
            <Component Id="LocaleRu" Guid="4b1a9c2e-0d3f-4a5b-8c6d-7e8f9a0b1c32" Win64="yes">
              <File Id="LocaleRuRu" Source="$(var.Stage)/locales/ru-RU.ftl" KeyPath="yes" />
            </Component>
            <Component Id="LocaleDe" Guid="4b1a9c2e-0d3f-4a5b-8c6d-7e8f9a0b1c33" Win64="yes">
              <File Id="LocaleDeDe" Source="$(var.Stage)/locales/de-DE.ftl" KeyPath="yes" />
            </Component>
          </Directory>
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Component Id="StartMenuShortcut" Guid="4b1a9c2e-0d3f-4a5b-8c6d-7e8f9a0b1c41">
          <Shortcut Id="FlightdeckShortcut" Name="Flightdeck" Description="Camunda 7 cockpit" Target="[INSTALLDIR]flightdeck.exe" WorkingDirectory="INSTALLDIR" Icon="FlightdeckIcon" />
          <RegistryValue Root="HKCU" Key="Software\Flightdeck" Name="installed" Type="integer" Value="1" KeyPath="yes" />
        </Component>
      </Directory>
    </Directory>

    <Feature Id="Complete" Title="Flightdeck" Level="1">
      <ComponentRef Id="MainExe" />
      <ComponentRef Id="License" />
      <ComponentRef Id="RunInPlace" />
      <ComponentRef Id="LocaleEn" />
      <ComponentRef Id="LocaleRu" />
      <ComponentRef Id="LocaleDe" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>
  </Product>
</Wix>
